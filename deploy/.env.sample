# Fresko UAT. Copy to deploy/.env — that file is gitignored.
#
# This file feeds `docker compose` variable interpolation only. It is NOT the
# app's runtime config: Vite inlines VITE_* at build time, so changing this
# requires `up -d --build`, not a restart.

# Same-origin. nginx serves the SPA and proxies /api/ to Heimdall on one host,
# so there is no hostname to go stale and no CORS to keep in sync.
#
# vite.config.ts's assertApiUrl() rejects empty values and placeholder patterns —
# including anything containing `localhost`. Leave this as `/`.
VITE_API_URL=/

# Absolute origin used only for canonical/OG/Twitter tags (src/shared/seo.ts).
# .env.production carries https://phitopolis.com, which is correct for real
# production and wrong for UAT — this overrides it at build time.
VITE_SITE_URL=https://uat.phitopolis.io
